# Base de données
DB_URL=jdbc:postgresql://localhost:5432/taskdb
DB_USER=task
DB_PASSWORD=change-me

# JWT : clé Base64 d'au moins 32 octets
JWT_SECRET=replace-with-base64-secret
JWT_EXPIRATION=7200000

# Application
SPRING_PROFILES_ACTIVE=
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
ALLOWED_EMAIL_DOMAINS=
REMINDERS_CRON="0 0 8 * * *"

# SMTP local : Mailpit, interface sur http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@taskflow.local
MAIL_PROTOCOL=smtp
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false
MAIL_SSL_ENABLE=false
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
